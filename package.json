{
  "name": "@kirtijha/carbon-salesforce-mcp-server",
  "version": "1.0.1",
  "description": "MCP server for Carbon for Salesforce development. Browse component source code, explore implementation patterns, and get real examples for building Carbon-compliant Salesforce UIs. Supports stdio + HTTP modes.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "carbon-salesforce-mcp": "dist/index.js",
    "carbon-salesforce-http": "dist/http-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/*.js",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev": "npm run build && npm run start",
    "dev:http": "npm run build && npm run start:http",
    "prepare": "npm run build",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "carbon",
    "carbon-design-system",
    "salesforce",
    "lwc",
    "lightning-web-components",
    "design-system",
    "ai-assistant",
    "github-integration",
    "component-library",
    "http-server"
  ],
  "author": "kirtijha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.ibm.com/kirtijha/carbon-salesforce-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.ibm.com/kirtijha/carbon-salesforce-mcp-server/issues"
  },
  "homepage": "https://github.ibm.com/kirtijha/carbon-salesforce-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@octokit/rest": "^22.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.2"
  },
  "engines": {
    "node": ">=18"
  }
}
